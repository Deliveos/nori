pkgbase = nori-git
	pkgdesc = Scrollable-tiling Wayland compositor, a fork of niri
	pkgver = r3293.7ba04a2
	pkgrel = 1
	url = https://github.com/Deliveos/nori
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = clang
	makedepends = git
	makedepends = rust
	depends = cairo
	depends = glib2
	depends = glibc
	depends = libdisplay-info
	depends = libgcc
	depends = libinput
	depends = libpipewire
	depends = libxkbcommon
	depends = mesa
	depends = pango
	depends = pixman
	depends = seatd
	depends = systemd-libs
	depends = wayland
	depends = xdg-desktop-portal-impl
	optdepends = alacritty: terminal bound in the default config
	optdepends = bash: for the nori-session script
	optdepends = fuzzel: application launcher bound in the default config
	optdepends = mako: notification daemon
	optdepends = org.freedesktop.secrets: for apps that use the secret portal
	optdepends = swaybg: wallpaper tool
	optdepends = swaylock: screen locker bound in the default config
	optdepends = waybar: bar started by the default config
	optdepends = xdg-desktop-portal-gnome: required for screencasting
	optdepends = xdg-desktop-portal-gtk: fallback portal set in nori-portals.conf
	optdepends = xwayland-satellite: for running X11 apps
	provides = nori=r3293.7ba04a2
	provides = wayland-compositor
	conflicts = nori
	options = !debug
	options = !lto
	options = !strip
	source = nori::git+https://github.com/Deliveos/nori.git
	b2sums = SKIP

pkgname = nori-git
